# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://pothik_user:pothik_password@localhost:5432/pothik_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=super_secret_access_key_pothik_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_pothik_2026
JWT_REFRESH_EXPIRATION=7d

# SMS Provider Configuration (SSL Wireless BD)
SSL_WIRELESS_API_TOKEN=your_ssl_wireless_token
SSL_WIRELESS_SID=your_ssl_wireless_sid
SSL_WIRELESS_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# Google Maps Platform Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVER_KEY=your_firebase_fcm_server_key

# Cloudinary Configuration (Driver Document Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Sentry Monitoring
SENTRY_DSN=https://your_sentry_dsn@sentry.io/123456
